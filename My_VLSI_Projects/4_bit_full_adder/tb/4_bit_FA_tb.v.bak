`timescale 1ns / 1ps

module tb_rca4;

    // Inputs
    reg [3:0] a;
    reg [3:0] b;
    reg [3:0] cin;

    // Outputs
    wire [3:0] sum;
    wire cout;

    // Instantiate the Unit Under Test (DUT)
    rca4 dut (
        .a(a), 
        .b(b), 
        .cin(cin), 
        .sum(sum), 
        .cout(cout)
    );

    initial begin
        // Monitor outputs in the transcript window
        $monitor("Time=%0t | A=%d B=%d Cin=%b => Sum=%d Cout=%b", 
                 $time, a, b, cin, sum, cout);

        // Apply test vectors
        a = 4'd5;  b = 4'd3;  cin = 4'b0000; #10;
        a = 4'd12; b = 4'd7;  cin = 4'b0001; #10;
        a = 4'd15; b = 4'd15; cin = 4'b0001; #10;
        a = 4'd8;  b = 4'd2;  cin = 4'b0000; #10;

        $finish;
    end

endmodule